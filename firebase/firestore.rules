rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Checkball: "Ich bin dabei" bei Open Gyms. Jede Zusage ist ein leeres Dokument
    // rsvps/<open-gym-id>__<datum>/votes/<anonyme-id>. Lesen (Zählen) darf jede/r,
    // schreiben und löschen nur die eigene Zusage.
    match /rsvps/{occ}/votes/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && occ.matches('[a-z0-9-]{1,80}__[0-9]{4}-[0-9]{2}-[0-9]{2}')
        && request.resource.data.keys().hasOnly(['v'])
        && request.resource.data.v == 1;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
